# Public client configuration — matches Trek-Guider web: only API base URL is required for login/register.

# API Gateway base URL (no trailing slash) — same as web `apiBaseUrl`
EXPO_PUBLIC_API_BASE_URL=https://your-api-id.execute-api.region.amazonaws.com

# Marketing / web app (no trailing slash) — forgot password, booking handoff, and trek images:
# when the API returns only S3 keys in `heroImage`, the app loads images from
# `${EXPO_PUBLIC_WEB_BASE_URL}/api/media-asset/...` (same as the web app when Next has MEDIA_ASSET_PROXY=true).
EXPO_PUBLIC_WEB_BASE_URL=https://your-website.example.com

# Optional; defaults to ${EXPO_PUBLIC_WEB_BASE_URL}/guide/onboarding
EXPO_PUBLIC_GUIDE_ONBOARDING_URL=https://your-website.example.com/guide/onboarding
